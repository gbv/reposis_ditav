          </select>
        </div>
        <mir:help-pmud help-text="{i18n:ditav.form.scan_available.help}" pmud="false" />
      </div>
    </xed:bind>
  </xed:template>

  <xed:template id="ditav.related.item.other.search.of.all.items">
    <xed:bind xpath="mods:relatedItem[@otherType]">
      <div class="mir-related-item-search">
        <div class="mir-form-group row">
          <div class="col-md-3 col-form-label text-end form-labe">
            <xed:bind xpath="@otherType">
                <xed:output i18n="ditav.related.item.other.described_in.label" />
                <input type="hidden" value="described_in" />              
            </xed:bind>
          </div>
          <div class="col-md-6">
            <div class="form-control form-inline nameType">
              <input type="button" class="form-control mir-relatedItem-select" data-fq="-id:{$id}" value="{i18n:mir.editing.related.select}" />
              <span />
              <xed:bind xpath="@xlink:href">
                <input type="hidden" />
              </xed:bind>
            </div>
          </div>
          <mir:help-pmud help-text="{i18n:mir.help.related.item}" pmud="false" />
        </div>
      </div>
    </xed:bind>
    <script src="{$WebApplicationBaseURL}js/mir/relatedItem-modal.min.js" type="text/javascript"></script>
  </xed:template>

  <!-- genre classification -->
  <xed:template id="genre.base">
    <label class="col-md-3 col-form-label text-end form-label">
      <xed:output i18n="lod_document_classification.type.label" />
    </label>
    <div class="col-md-6">
      <div class="controls">
        <select class="form-control form-control-inline form-select">
          <option value="">
            <xed:output i18n="mir.select" />
          </option>
          <xed:include uri="xslStyle:items2options:classification:editor:-1:children:mir_genres" />
        </select>
      </div>
    </div>
  </xed:template>

  <!-- Project templates -->

  <!--GAZIN -->

  <!-- gazin genre classification -->
  <xed:template id="gazin_genres">
    <xed:bind xpath="mods:classification[@authorityURI='https://ditav.gbv.de/api/v2/classifications/gazin_genres'][@displayLabel='gazin_genres']/@valueURIxEditor">
