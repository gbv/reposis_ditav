  <!-- scan available -->
  <xed:template id="ditav.mods.classification.scan_available">
    <xed:bind xpath="mods:classification[@authorityURI='https://ditav.gbv.de/api/v2/classifications/scan_available'][@displayLabel='scan_available']/@valueURIxEditor">
      <div class="mir-form-group row {$xed-validation-marker}">
