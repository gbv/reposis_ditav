      <!-- colony -->
      <xed:include ref="koloe_colony" />
      <!-- period -->
      <xed:include ref="koloe_period" />
      <!-- keywords -->
      <xed:include ref="subject.complex.required" />
      <!-- geographic and cartographic metadata -->
      <xed:include ref="geographicAndCartographics" />
      <!-- archives -->
      <xed:include ref="koloe_archives" />
      <!-- shelf mark -->
      <xed:include ref="shelfmark" />
      <!--link to the physical location of the resource -->
      <xed:include ref="link.repeated" />
      <!-- extent -->
      <xed:include ref="extent" />
      <!-- copyrights -->
      <xed:include ref="rights" />
      <!-- abstract -->
      <xed:include ref="abstract.repeated" />
      <!-- add resource class-->
      <xed:bind xpath="mods:typeOfResource/@mcr:categId" initially="typeOfResource:text" />
  </xed:template>



  <!-- koloe archives classification -->
   <xed:template id="koloe_archives">
    <xed:repeat xpath="mods:classification[@authorityURI='https://ditav.gbv.de/api/v2/classifications/koloe_archives'][@displayLabel='koloe_archives']" min="1">
      <xed:bind xpath="@valueURIxEditor">
        <div class="mir-form-group row {$xed-validation-marker}">
