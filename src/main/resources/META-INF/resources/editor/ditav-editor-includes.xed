    </xed:bind>
  </xed:template>

  <!-- koloe topic classification -->
  <xed:template id="koloe_topic_classification">
    <xed:repeat xpath="mods:classification[@authorityURI='https://ditav.gbv.de/api/v2/classifications/koloe_topic_classification'][@displayLabel='koloe_topic_classification']" min="1">
      <xed:bind xpath="@valueURIxEditor">
        <div class="mir-form-group row {$xed-validation-marker}">
          <label class="col-md-3 col-form-label text-end form-label">
            <xed:output i18n="koloe_topic_classification.label" />
          </label>
          <div class="col-md-6">
            <select class="form-control form-control-inline">
              <option value="">
                <xed:output i18n="mir.select.optional" />
              </option>
              <xed:include uri="xslStyle:items2options:classification:editor:-1:children:koloe_topic_classification" />
            </select>
          </div>
          <mir:help-pmud help-text="{i18n:koloe_topic_classification.help}" pmud="true" />
        </div>
      </xed:bind>
    </xed:repeat>
  </xed:template>

  <!-- koloe trigger warning classification -->
  <xed:template id="koloe_trigger_warning">
    <xed:repeat xpath="mods:classification[@authorityURI='https://ditav.gbv.de/api/v2/classifications/koloe_trigger_warning'][@displayLabel='koloe_trigger_warning']" min="1">
      <xed:bind xpath="@valueURIxEditor">
        <div class="mir-form-group row {$xed-validation-marker}">
          <label class="col-md-3 col-form-label text-end form-label">
            <xed:output i18n="koloe_trigger_warning.label" />
          </label>
          <div class="col-md-6">
            <select class="form-control form-control-inline">
              <option value="">
                <xed:output i18n="mir.select.optional" />
              </option>
              <xed:include uri="xslStyle:items2options:classification:editor:-1:children:koloe_trigger_warning" />
            </select>
          </div>
          <mir:help-pmud help-text="{i18n:koloe_trigger_warning.help}" pmud="true" />
        </div>
      </xed:bind>
    </xed:repeat>
  </xed:template>

  <!-- Edition binding for DITAV -->
  <xed:template id="ditav.edition.bind">
    <xed:bind xpath="mods:relatedItem[@type='host']">
      <xed:choose>
        <xed:when test="string-length(normalize-space($edition)) &gt; 0">
          <xed:bind xpath="@xlink:href" initially="{$edition}_mods_00000001">
            <input id="relItem-edition" type="hidden" />
            <xed:output value="@xlink:href" />
          </xed:bind>
        </xed:when>
        <xed:when test="string-length($relatedItemId) &gt; 0 and contains($relatedItemId, '_mods_')">
          <!-- Reference the parent document itself (not an incremented version) -->
          <xed:bind xpath="@xlink:href" initially="{$relatedItemId}">
            <input id="relItem-edition" type="hidden" />
          </xed:bind>
        </xed:when>
        <xed:otherwise>
          <div class="alert alert-danger" role="alert">Missing Edition.Id URL parameter.</div>
        </xed:otherwise>
      </xed:choose>
    </xed:bind>
  </xed:template>

  <!-- edition id -->
  <xed:template id="ditav.edition.id">
    <xed:bind xpath="/mycoreobject/@ID">
      <mir:textfield xpath="." label="ditav.mods.edition.id.label" help-text="{i18n:ditav.mods.edition.id.help}" placeholder="{i18n:ditav.mods.edition.id.placeholder}" />
    </xed:bind>
  </xed:template>

  <!-- comment on source, language, original or copy -->
  <xed:template id="comment.complex">
    <fieldset>
      <legend class="mir-fieldset-legend">
        <xed:output i18n="mir.comment" />
      </legend>
      <xed:repeat xpath="mods:note" min="1" max="5">
        <div class="mir-fieldset-content">
          <div class="mir-form-group row">
            <label class="col-md-3 col-form-label text-end form-label">
              <xed:output i18n="mir.comment.type" />
            </label>
            <div class="col-md-6">
              <xed:bind xpath="@type">
                <select class="form-control">
                  <option value="">
                    <xed:output i18n="mir.select" />
                  </option>
                  <xed:include uri="xslStyle:items2options,convertClassificationOptions:classification:editor:-1:children:noteTypes" />
                </select>
              </xed:bind>
            </div>
            <mir:help-pmud help-text="{i18n:mir.help.comment.type}" pmud="true" />
          </div>
          <mir:textarea xpath="." label="mir.comment" help-text="{i18n:mir.help.comment}" rows="3" />
        </div>
      </xed:repeat>
    </fieldset>
  </xed:template>

  <!-- ? -->
  <xed:template id="lod.genre.base">
    <label class="col-md-3 col-form-label text-end form-label">
      <xed:output i18n="ditav.mods.genre.label" />
    </label>
    <div class="col-md-6">
      <div class="controls">
        <select class="form-control form-control-inline">
          <option value="">
            <xed:output i18n="mir.select" />
          </option>
          <xed:include uri="xslStyle:items2options:classification:editor:-1:children:mir_genres" />
        </select>
      </div>
    </div>
  </xed:template>

  <xed:template id="lod.genre">
    <xed:load-resource name="mir_genres" uri="classification:metadata:-1:children:mir_genres" />
    <xed:if test="mods:genre[@type='intern'][not(@authorityURI)]">
      <xed:bind xpath="mods:genre[@type='intern'][not(@authorityURI)]">
        <xed:bind xpath="@authorityURI" set="{$mir_genres/label[@xml:lang='x-uri']/@text}" />
      </xed:bind>
    </xed:if>
    <xed:bind xpath="mods:genre[@type='intern'][@authorityURI=$mir_genres/label[@xml:lang='x-uri']/@text]">
      <xed:bind xpath="@valueURIxEditor" initially="{$genre}">
        <div class="mir-form-group row required {$xed-validation-marker}">
          <xed:include ref="lod.genre.base" />
          <mir:help-pmud help-text="{i18n:ditav.mods.genre.help}" pmud="false" />
        </div>
      </xed:bind>
    </xed:bind>
  </xed:template>

  <!-- identifier (internal) -->
  <xed:template id="identifier.intern">
    <mir:textfield xpath="mods:identifier[@type='intern']" label="mir.identifier.intern" help-text="{i18n:mir.help.identifier.intern}" />
  </xed:template>

  <!-- host TODO: check if needed -->
  <xed:template id="hosts.edition">
    <xed:bind xpath="mods:relatedItem[@type='host']">
      <xed:choose>
        <xed:when test="string-length($relatedItemId) &gt; 0 and contains($relatedItemId, '_mods_')">
          <!-- Reference the parent document itself (not an incremented version) -->
          <xed:bind xpath="@xlink:href" initially="{$relatedItemId}">
            <input id="relItem-edition" type="hidden" />
          </xed:bind>
        </xed:when>
        <xed:otherwise>
          <xed:bind xpath="@xlink:href" initially="{$MIR.projectid.default}_mods_00000000">
            <input id="relItem-edition" type="hidden" />
          </xed:bind>
        </xed:otherwise>
      </xed:choose>
      <xed:include ref="title.book.relItemsearch" />
      <xed:include ref="subtitle" />
      <xed:include ref="author.repeated" />
      <xed:include ref="editor.repeated" />
      <xed:include ref="hosts.collection.common.publisher" />
      <xed:include ref="identifier.isbn.book.relItemsearch" />
      <xed:include ref="shelfmark.book.relItemsearch" />
      <xed:include ref="host.pages" />
    </xed:bind>
  </xed:template>

  <!-- ============ Edition Templates ============ -->

  <!-- Edition title -->
  <xed:template id="ditav.edition.title" repeatable="true" required="true" type="textfield">
    <xed:bind xpath="mods:mods/mods:titleInfo[not(@type)]">
      <div class="mir-form-group row align-items-center mb-0 {$xed-validation-marker}">
        <label class="col-md-3 col-form-label mir-formgroup-label d-flex justify-content-end align-items-center gap-2 text-nowrap pe-3">
          <xed:output i18n="ditav.mods.title.label" />
          <xed:bind xpath="@xml:lang" initially="en">
            <select class="form-control form-control-inline lang-select form-select ms-1 flex-grow-1" data-dlang="{$MCR.Metadata.DefaultLang}" data-langs="{$MCR.Metadata.Languages}">
              <xed:choose>
                <xed:when test="string-length(.) &gt; 0">
                  <option value="{.}" selected="">
                    <xed:output value="." />
                  </option>
                </xed:when>
                <xed:otherwise>
                  <option value="{$MCR.Metadata.DefaultLang}" selected="">
                    <xed:output value="{$MCR.Metadata.DefaultLang}" />
                  </option>
                </xed:otherwise>
              </xed:choose>
            </select>
          </xed:bind>
        </label>
        <div class="col-md-6 d-flex align-items-center">
          <xed:bind xpath="mods:title">
            <input type="text" class="form-control" placeholder="{i18n:mir.editor.title.placeholder}" />
          </xed:bind>
        </div>
        <div class="col-md-3 text-nowrap">
          <mir:help-pmud help-text="{i18n:mir.help.title}" pmud="false" />
        </div>
      </div>
    </xed:bind>
  </xed:template>

  <!-- Edition translated title -->
  <xed:template id="ditav.edition.translated_title" repeatable="true" type="textfield">
    <xed:repeat xpath="mods:mods/mods:titleInfo[@type='translated']" min="1" max="6">
      <div class="mir-form-group row align-items-center {$xed-validation-marker}">
        <label class="col-md-3 col-form-label mir-formgroup-label d-flex justify-content-end align-items-center gap-2 text-nowrap pe-3">
          <xed:output i18n="ditav.mods.title-translated.label" />
          <xed:bind xpath="@xml:lang" initially="en">
            <select class="form-control form-control-inline lang-select form-select ms-1 flex-grow-1" data-dlang="{$MCR.Metadata.DefaultLang}" data-langs="{$MCR.Metadata.Languages}">
              <xed:choose>
                <xed:when test="string-length(.) &gt; 0">
                  <option value="{.}" selected="">
                    <xed:output value="." />
                  </option>
                </xed:when>
                <xed:otherwise>
                  <option value="{$MCR.Metadata.DefaultLang}" selected="">
                    <xed:output value="{$MCR.Metadata.DefaultLang}" />
                  </option>
                </xed:otherwise>
              </xed:choose>
            </select>
          </xed:bind>
        </label>
        <div class="col-md-6 d-flex align-items-center">
          <xed:bind xpath="mods:title">
            <input type="text" class="form-control" placeholder="{i18n:ditav.mods.title-in-language.placeholder}" />
          </xed:bind>
        </div>
        <div class="col-md-3 text-nowrap">
          <mir:help-pmud help-text="{i18n:ditav.mods.title-in-language.validation}" pmud="true" />
        </div>
      </div>
    </xed:repeat>
  </xed:template>

  <!-- Edition agent -->
  <xed:template id="ditav.edition.agent" repeatable="true" type="textfield">
    <xed:bind xpath="mods:mods/mods:originInfo[@eventType='created']">
      <xed:repeat xpath="mods:agent[@type='personal']" min="0" max="10">
        <div class="mir-form-group row align-items-center {$xed-validation-marker} mb-3">
          <xed:bind xpath="mods:role/mods:roleTerm[@authority='marcrelator'][@type='code']">
            <input type="hidden" value="aut" />
          </xed:bind>
          <label class="col-md-3 col-form-label mir-formgroup-label d-flex justify-content-end align-items-center gap-2 text-nowrap pe-3">
            <xed:output i18n="ditav.mods.originInfo.created.author" />
          </label>
          <div class="col-md-6 d-flex align-items-center">
            <xed:bind xpath="mods:displayForm">
              <input type="text" class="form-control" placeholder="{i18n:ditav.mods.agent.name.placeholder}" />
            </xed:bind>
          </div>
          <div class="col-md-3 text-nowrap">
            <mir:help-pmud help-text="{i18n:ditav.mods.agent.displayForm.help}" pmud="true" />
          </div>
          <div class="col-md-3 col-form-label mir-formgroup-label d-flex justify-content-end align-items-center gap-2 text-nowrap pe-3"></div>
          <div class="col-md-6 align-items-center">
            <details>
              <summary class="btn btn-outline-secondary btn-sm">
                <xed:output i18n="ditav.mods.agent.details" />
              </summary>
              <div class="mt-2 border rounded p-3">
                <div class="mir-form-group row {$xed-validation-marker}">
                  <label class="col-md-3 col-form-label text-end form-label">
                    <xed:output i18n="ditav.mods.agent.name" />
                  </label>
                  <div class="col-md-6">
                    <xed:bind xpath="mods:namePart">
                      <input type="text" class="form-control" />
                    </xed:bind>
                  </div>
                  <mir:help-pmud help-text="{i18n:mir.help.agent.namePart}" pmud="true" />
                </div>
                <div class="mir-form-group row {$xed-validation-marker}">
                  <label class="col-md-3 col-form-label text-end form-label">
                    <xed:output i18n="ditav.mods.agent.nameIdentifier" />
                  </label>
                  <div class="col-md-6">
                    <xed:bind xpath="mods:nameIdentifier">
                      <input type="text" class="form-control" />
                    </xed:bind>
                  </div>
                  <mir:help-pmud help-text="{i18n:mir.help.agent.nameIdentifier}" pmud="true" />
                </div>
                <div class="mir-form-group row {$xed-validation-marker}">
                  <label class="col-md-3 col-form-label text-end form-label">
                    <xed:output i18n="ditav.mods.agent.description" />
                  </label>
                  <div class="col-md-6">
                    <xed:bind xpath="mods:description">
                      <input type="text" class="form-control" />
                    </xed:bind>
                  </div>
                  <mir:help-pmud help-text="{i18n:mir.help.agent.description}" pmud="true" />
                </div>
              </div>
            </details>
          </div>
        </div>
      </xed:repeat>
    </xed:bind>
  </xed:template>

  <!-- Edition language -->
  <xed:template id="ditav.edition.language">
    <xed:repeat xpath="mods:mods/mods:language" max="5">
      <div class="mir-form-group row {$xed-validation-marker}">
        <label class="col-md-3 col-form-label text-end form-label">
          <xed:output i18n="mir.language" />
        </label>
        <div class="col-md-6">
          <xed:bind xpath="mods:languageTerm[@authority='rfc5646'][@type='code']" initially="de">
            <div class="controls">
              <xed:include ref="lang.list" />
            </div>
          </xed:bind>
        </div>
        <mir:help-pmud help-text="{i18n:mir.help.language}" pmud="true" />
      </div>
    </xed:repeat>
  </xed:template>

  <!-- Edition genre -->
  <xed:template id="ditav.edition.genre">
    <xed:load-resource name="mir_genres" uri="classification:metadata:-1:children:mir_genres" />
    <xed:if test="mods:mods/mods:genre[@type='intern'][not(@authorityURI)]">
      <xed:bind xpath="mods:mods/mods:genre[@type='intern'][not(@authorityURI)]">
        <xed:bind xpath="@authorityURI" set="{$mir_genres/label[@xml:lang='x-uri']/@text}" />
      </xed:bind>
    </xed:if>
    <xed:repeat xpath="mods:mods/mods:genre[@type='intern'][@authorityURI=$mir_genres/label[@xml:lang='x-uri']/@text]" min="1" max="10">
      <xed:bind xpath="@valueURIxEditor" initially="{$genre}">
        <div class="mir-form-group row required {$xed-validation-marker}">
          <xed:include ref="genre.base" />
          <mir:help-pmud help-text="{i18n:mir.help.genre}" pmud="true" />
        </div>
      </xed:bind>
    </xed:repeat>
  </xed:template>
  
  <!-- Initialise mir_genre with edition as default -->
  <xed:template id="ditav.edition.genre.bind">
    <xed:load-resource name="mir_genres" uri="classification:metadata:-1:children:mir_genres" />
    <xed:bind xpath="mods:genre[@type='intern'][@authorityURI=$mir_genres/label[@xml:lang='x-uri']/@text]">
      <xed:bind xpath="@valueURIxEditor" initially="edition" />
    </xed:bind>
  </xed:template>

  <!-- Edition subject -->
  <xed:template id="ditav.edition.subject" repeatable="true">
    <xed:repeat xpath="mods:mods/mods:subject" min="0" max="10">
      <div class="mir-form-group row {$xed-validation-marker}">
        <label class="col-md-3 col-form-label text-end form-label">
          <xed:output i18n="mir.subject" />
        </label>
        <div class="col-md-6">
          <xed:bind xpath="mods:topic">
            <input type="text" class="form-control" />
          </xed:bind>
        </div>
        <mir:help-pmud help-text="{i18n:mir.help.subject}" pmud="true" />
      </div>
    </xed:repeat>
  </xed:template>

  <!--
  <xed:template id="ditav.author.repeated">
    <mir:agent.role.repeated role="aut" label="mir.role.author" help-text="{i18n:mir.help.role.author}" />
  </xed:template>-->

  <!-- ToDo: Remove once title.complex.repeated is fixed https://mycore.atlassian.net/browse/MIR-1643 -->
  <xed:template id="title.complex.repeated">
    <fieldset>
      <legend class="mir-fieldset-legend">
        <xed:output i18n="mir.title.type" />
      </legend>
      <xed:repeat xpath="mods:titleInfo" min="1" max="6">
        <div class="mir-fieldset-content">
          <div class="mir-form-group row">
            <label class="col-md-3 col-form-label text-end form-label">
              <xed:output i18n="mir.title.nonSort" />
            </label>
            <div class="col-md-6">
              <div class="d-flex align-items-center controls gap-2">
                <xed:bind xpath="mods:nonSort">
                  <input type="text" size="9" class="form-control form-control-inline" placeholder="Der/Die/Das" />
                </xed:bind>
                <xed:bind xpath="@xml:lang" initially="de">
                  <xed:include ref="lang.list" />
                </xed:bind>
                <xed:bind xpath="@type">
                  <select class="form-control form-control-inline form-select">
                    <option value="">
                      <xed:output i18n="mir.title.type.main" />
                    </option>
                    <option value="translated">
                      <xed:output i18n="mir.title.type.translated" />
                    </option>
                    <option value="alternative">
                      <xed:output i18n="mir.title.type.alternative" />
                    </option>
                    <option value="abbreviated">
                      <xed:output i18n="mir.title.type.abbreviated" />
                    </option>
                    <option value="uniform">
                      <xed:output i18n="mir.title.type.uniform" />
                    </option>
                  </select>
                </xed:bind>
              </div>
            </div>
            <mir:help-pmud help-text="{i18n:mir.help.title.complex}" pmud="true" />
          </div>
          <mir:textarea xpath="mods:title" rows="2" label="mir.title" help-text="{i18n:mir.help.title}" />
          <mir:textarea xpath="mods:subTitle" rows="2" label="mir.title.subTitle" help-text="{i18n:mir.help.title.subTitle}" />
        </div>
      </xed:repeat>
    </fieldset>
  </xed:template>

  <!-- ========== validation ========== -->

  <!-- ========== cleanup rules ========== -->

  <xed:template id="ditav-cleanup-rules">
    <xed:cleanup>
      <!-- Cleanup rules for agent elements -->
      <xed:cleanup-rule xpath="//mods:agent" relevant-if="(mods:namePart|mods:displayForm|mods:nameIdentifier|mods:description) or (string-length(@valueURI) &gt; 0) or (string-length(@valueURIxEditor) &gt; 0)" />
      <xed:cleanup-rule xpath="//mods:agent/@authorityURI" relevant-if="(string-length(../@valueURI) &gt; 0) or (string-length(../@valueURIxEditor) &gt; 0)" />
    </xed:cleanup>
  </xed:template>

</xed:template>