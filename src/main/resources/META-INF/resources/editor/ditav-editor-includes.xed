  <!-- koloe text classification -->
  <xed:template id="koloe_text_classification">
    <xed:bind xpath="mods:classification[@authorityURI='https://ditav.gbv.de/api/v2/classifications/koloe_text_classification'][@displayLabel='koloe_text_classification']/@valueURIxEditor">
