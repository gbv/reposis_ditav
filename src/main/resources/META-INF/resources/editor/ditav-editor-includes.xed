<?xml version="1.0" encoding="UTF-8"?>
<xed:template xmlns:xed="http://www.mycore.de/xeditor"
  xmlns:mir="http://www.mycore.de/mir">

  <!-- ============ mycore ============== -->

  <!-- Extends the common template for mycore with the option to use the project id of the host document -->
  <xed:template id="mycore.common">
    <xed:choose>
      <xed:when test="metadata/def.modsContainer/modsContainer/mods:mods/mods:relatedItem[@type='host']">
        <xed:bind xpath="@ID" initially="{substring-before(metadata/def.modsContainer/modsContainer/mods:mods/mods:relatedItem[@type='host']/@xlink:href, '_')}_mods_00000000" />
      </xed:when>
      <xed:when test="string-length($origin) &gt; 0">
        <xed:bind xpath="@ID" initially="{$origin}_mods_00000000" />
      </xed:when>
      <xed:when test="xed:call-java('org.mycore.common.xml.MCRXMLFunctions','getCurrentUserAttribute','origin')">
        <xed:bind xpath="@ID" initially="{xed:call-java('org.mycore.common.xml.MCRXMLFunctions','getCurrentUserAttribute','origin')}_mods_00000000" />
      </xed:when>
      <xed:otherwise>
        <xed:bind xpath="@ID" initially="{$MIR.projectid.default}_mods_00000000" />
      </xed:otherwise>
    </xed:choose>
    <input type="hidden" name="XSL.Status.Message" value="mir.editstatus.success" />
    <input type="hidden" name="XSL.Status.Style" value="success" />
  </xed:template>

  <!-- ============ admin editor ============== -->

  <xed:modify ref="admin.fields">
    <!-- Select edition project -->
    <xed:include ref="{concat(substring-before(/mycoreobject/@ID, '_mods_'), '.edition.admin')}" after="sdnb.repeat" />
    <xed:remove ref="sdnb.repeat" />
    <xed:remove ref="openAIRE" />
    <xed:remove ref="project.repeated" />
  </xed:modify>

  <xed:template id="gzn.edition.admin">
    <xed:include ref="gzn.edition" />
  </xed:template>

  <xed:template id="koloe.edition.admin">
    <xed:include ref="koloe_archives" />
    <xed:include ref="koloe_document_classification" />
    <xed:include ref="koloe_topic_classification" />
    <xed:include ref="koloe_text_classification" />
    <xed:include ref="koloe_trigger_warning" />
    <xed:include ref="koloe_continents" />
    <xed:include ref="koloe_colony" />
    <xed:include ref="koloe_period" />
  </xed:template>

  <xed:template id="lod.edition.admin">
    <xed:include ref="lod.edition" />
  </xed:template>


  <!-- ========== genres ========== -->

  <xed:template id="genres.contextual_information">
    <xed:include ref="failed-validation-messages" />
    <xed:bind xpath="../../../../service">
      <xed:include ref="status" />
    </xed:bind>
    <!-- Select edition project -->
    <xed:include ref="{concat(substring-before(/mycoreobject/@ID, '_mods_'), '.genres.contextual_information')}" />
  </xed:template>

  <xed:template id="genres.document">
    <xed:include ref="failed-validation-messages" />
    <xed:bind xpath="../../../../service">
      <xed:include ref="status" />
    </xed:bind>
    <!-- Select edition project -->
    <xed:include ref="{concat(substring-before(/mycoreobject/@ID, '_mods_'), '.genres.document')}" />
  </xed:template>

  <xed:template id="genres.edition">
    <xed:include ref="failed-validation-messages" />
    <xed:bind xpath="../../../../service">
      <xed:include ref="status" />
    </xed:bind>
    <xed:include ref="ditav.edition" />
  </xed:template>

  <!--  <xed:template id="genres.submit">
    <xed:include ref="cancel.submit" />
    <xed:include ref="cleanup-rules" />
    <xed:include ref="ditav-cleanup-rules" />
    <xed:include ref="validation-rules" />
  </xed:template>

  
  <xed:template id="cancel.submit">
    <xed:include ref="debug.cancel.submit" />
  </xed:template>
  -->

  <xed:template id="genres.source">
    <xed:include ref="failed-validation-messages" />

    <xed:bind xpath="../../../../service">
      <xed:include ref="status" />
    </xed:bind>
    <!-- Select edition project -->
    <xed:choose>
      <xed:when test="string-length(/mycoreobject/@ID) &gt; 0">
        <xed:include ref="{concat(substring-before(/mycoreobject/@ID, '_mods_'), '.genres.source')}" />
      </xed:when>
      <xed:otherwise>
        <xed:include ref="{concat(substring-before(/metadata/def.modsContainer/modsContainer/mods:mods/mods:relatedItem[@type='host']/@ID, '_mods_'), '.genres.source')}" />
      </xed:otherwise>
    </xed:choose>
  </xed:template>

  <xed:template id="genres.supplement">
    <xed:include ref="failed-validation-messages" />

    <xed:bind xpath="../../../../service">
      <xed:include ref="status" />
    </xed:bind>
    <!-- Select edition project -->
    <xed:include ref="{concat(substring-before(/mycoreobject/@ID, '_mods_'), '.genres.supplement')}" />
  </xed:template>

  <!-- ========== templates ========== -->

  <!-- title (language) -->
  <xed:template id="ditav.mods.title" repeatable="true" required="true" type="textfield">
    <xed:bind xpath="mods:titleInfo[not(@type)]">
      <div class="mir-form-group row align-items-center mb-0 {$xed-validation-marker}">
        <label class="col-md-3 col-form-label mir-formgroup-label d-flex justify-content-end align-items-center gap-2 text-nowrap pe-3">
          <xed:output i18n="ditav.mods.title.label" />
          <xed:bind xpath="@xml:lang" initially="en">
            <select class="form-control form-control-inline lang-select form-select ms-1 flex-grow-1" data-dlang="{$MCR.Metadata.DefaultLang}" data-langs="{$MCR.Metadata.Languages}">
              <xed:choose>
                <xed:when test="string-length(.) &gt; 0">
                  <option value="{.}" selected="">
                    <xed:output value="." />
                  </option>
                </xed:when>
                <xed:otherwise>
                  <option value="{$MCR.Metadata.DefaultLang}" selected="">
                    <xed:output value="{$MCR.Metadata.DefaultLang}" />
                  </option>
                </xed:otherwise>
              </xed:choose>
            </select>
          </xed:bind>
        </label>
        <div class="col-md-6 d-flex align-items-center">
          <xed:bind xpath="mods:title">
            <input type="text" class="form-control" placeholder="{i18n:mir.editor.title.placeholder}" />
          </xed:bind>
        </div>
        <div class="col-md-3 text-nowrap">
          <mir:help-pmud help-text="{i18n:mir.help.title}" pmud="false" />
        </div>
      </div>
    </xed:bind>
  </xed:template>

  <!-- translated title (language) -->
  <xed:template id="ditav.mods.translated_title" repeatable="true" type="textfield">
    <xed:repeat xpath="mods:titleInfo[@type='translated']" min="1" max="6">
      <div class="mir-form-group row align-items-center {$xed-validation-marker}">
        <label class="col-md-3 col-form-label mir-formgroup-label d-flex justify-content-end align-items-center gap-2 text-nowrap pe-3">
          <xed:output i18n="ditav.mods.title-translated.label" />
          <xed:bind xpath="@xml:lang" initially="en">
            <select class="form-control form-control-inline lang-select form-select ms-1 flex-grow-1" data-dlang="{$MCR.Metadata.DefaultLang}" data-langs="{$MCR.Metadata.Languages}">
              <xed:choose>
                <xed:when test="string-length(.) &gt; 0">
                  <option value="{.}" selected="">
                    <xed:output value="." />
                  </option>
                </xed:when>
                <xed:otherwise>
                  <option value="{$MCR.Metadata.DefaultLang}" selected="">
                    <xed:output value="{$MCR.Metadata.DefaultLang}" />
                  </option>
                </xed:otherwise>
              </xed:choose>
            </select>
          </xed:bind>
        </label>
        <div class="col-md-6 d-flex align-items-center">
          <xed:bind xpath="mods:title">
            <input type="text" class="form-control" placeholder="{i18n:ditav.mods.title-in-language.placeholder}" />
          </xed:bind>
        </div>
        <div class="col-md-3 text-nowrap">
          <mir:help-pmud help-text="{i18n:ditav.mods.title-in-language.validation}" pmud="true" />
        </div>
      </div>
    </xed:repeat>
  </xed:template>

  <!-- author (agent) -->
  <xed:template id="ditav.mods.agent.author" repeatable="true" type="textfield">
    <xed:bind xpath="mods:originInfo[@eventType='created']">
      <xed:repeat xpath="mods:agent[@type='personal']" min="0" max="10">
        <div class="mir-form-group row align-items-center {$xed-validation-marker} mb-3">
          <xed:bind xpath="mods:role/mods:roleTerm[@authority='marcrelator'][@type='code']">
            <input type="hidden" value="aut" />
          </xed:bind>
          <label class="col-md-3 col-form-label mir-formgroup-label d-flex justify-content-end align-items-center gap-2 text-nowrap pe-3">
            <xed:output i18n="ditav.mods.originInfo.created.author" />
          </label>
          <div class="col-md-6 d-flex align-items-center">
            <xed:bind xpath="mods:displayForm">
              <input type="text" class="form-control" placeholder="{i18n:mir.editor.title.placeholder}" />
            </xed:bind>
          </div>
          <div class="col-md-3 text-nowrap">
            <mir:help-pmud help-text="{i18n:ditav.mods.agent.displayForm.help}" pmud="true" />
          </div>
          <div class="col-md-3 col-form-label mir-formgroup-label d-flex justify-content-end align-items-center gap-2 text-nowrap pe-3"></div>
          <div class="col-md-6 align-items-center">
            <details>
              <summary class="btn btn-outline-secondary btn-sm">
                <xed:output i18n="ditav.mods.agent.details" />
              </summary>
              <div class="mt-2 border rounded p-3">
                <mir:textfield xpath="mods:namePart[@type='family']" label="mir.editor.subject.name.editor.namePart.type.family" help-text="{i18n:mir.help.name.family}" />
                <mir:textfield xpath="mods:namePart[@type='given']" label="mir.editor.subject.name.editor.namePart.type.given" help-text="{i18n:mir.help.name.given}" />
                <mir:textfield xpath="mods:nameIdentifier[@type='dante']" label="ditav.mods.agent.nameIdentifier" help-text="{i18n:ditav.mods.agent.nameIdentifier.help}" placeholder="{i18n:ditav.mods.agent.nameIdentifier.uuid}" />
                <xed:bind xpath="mods:nameIdentifier[@type='dante']/@typeURI" initially="https://uri.gbv.de/terminology/lod_persons/">
                  <input type="hidden" />
                </xed:bind>
                <mir:textfield xpath="mods:description" label="ditav.mods.agent.description" help-text="{i18n:ditav.mods.agent.description.help}" placeholder="{i18n:ditav.mods.agent.description.placeholder}" />
              </div>
            </details>
          </div>
        </div>
      </xed:repeat>
    </xed:bind>
  </xed:template>

  <!-- date of creation -->
  <xed:template id="ditav.mods.originInfo.created.displayDate">
    <mir:textfield xpath="mods:originInfo[@eventType='created']/mods:displayDate" label="ditav.mods.originInfo.created.displayDate" help-text="{i18n:ditav.mods.originInfo.created.displayDate.help}" placeholder="{i18n:ditav.mods.originInfo.created.displayDate.placeholder}" />
  </xed:template>

  <!-- place of creation -->
  <xed:template id="ditav.mods.originInfo.created.placeTerm" repeatable="true">
    <xed:repeat xpath="mods:originInfo[@eventType='created']/mods:place" min="0" max="10">
      <div class="mir-form-group row align-items-center {$xed-validation-marker} mb-3">
        <label class="col-md-3 col-form-label mir-formgroup-label d-flex justify-content-end align-items-center gap-2 text-nowrap pe-3">
          <xed:output i18n="ditav.mods.originInfo.created.placeTerm" />
        </label>
        <div class="col-md-6 d-flex align-items-center">
          <xed:bind xpath="mods:placeTerm">
            <input type="text" class="form-control" placeholder="{i18n:ditav.mods.originInfo.created.placeTerm.placeholder}" />
          </xed:bind>
        </div>
        <div class="col-md-3 text-nowrap">
          <mir:help-pmud help-text="{i18n:ditav.mods.originInfo.created.placeTerm.help}" pmud="true" />
        </div>
        <div class="col-md-3 col-form-label mir-formgroup-label d-flex justify-content-end align-items-center gap-2 text-nowrap pe-3"></div>
        <div class="col-md-6 align-items-center">
          <details>
            <summary class="btn btn-outline-secondary btn-sm">
              <xed:output i18n="ditav.mods.agent.details" />
            </summary>
            <div class="mt-2 border rounded p-3">
              <mir:textfield xpath="mods:placeIdentifier" label="ditav.mods.originInfo.created.placeIdentifier" help-text="{i18n:ditav.mods.originInfo.created.placeIdentifier.help}" placeholder="{i18n:ditav.mods.originInfo.created.placeIdentifier.placeholder}" />
              <mir:textfield xpath="mods:cartographics/coordinates" label="ditav.mods.originInfo.created.coordinates" help-text="{i18n:mir.help.place}" placeholder="{i18n:ditav.mods.originInfo.created.coordinates.placeholder}" />
            </div>
          </details>
        </div>
      </div>
    </xed:repeat>
  </xed:template>

  <!-- recipient (agent) -->
  <xed:template id="ditav.mods.originInfo.received.recipient" repeatable="true">
    <xed:bind xpath="mods:originInfo[@eventType='received']">
      <xed:repeat xpath="mods:agent[@type='personal']" min="0" max="10">
        <div class="mir-form-group row align-items-center {$xed-validation-marker} mb-3">
          <xed:bind xpath="mods:role/mods:roleTerm[@authority='marcrelator'][@type='code']">
            <input type="hidden" value="rcp" />
          </xed:bind>
          <label class="col-md-3 col-form-label mir-formgroup-label d-flex justify-content-end align-items-center gap-2 text-nowrap pe-3">
            <xed:output i18n="ditav.mods.originInfo.received.recipient" />
          </label>
          <div class="col-md-6 d-flex align-items-center">
            <xed:bind xpath="mods:displayForm">
              <input type="text" class="form-control" placeholder="{i18n:mir.editor.title.placeholder}" />
            </xed:bind>
          </div>
          <div class="col-md-3 text-nowrap">
            <mir:help-pmud help-text="{i18n:ditav.mods.agent.displayForm.help}" pmud="true" />
          </div>
          <div class="col-md-3 col-form-label mir-formgroup-label d-flex justify-content-end align-items-center gap-2 text-nowrap pe-3"></div>
          <div class="col-md-6 align-items-center">
            <details>
              <summary class="btn btn-outline-secondary btn-sm">
                <xed:output i18n="ditav.mods.agent.details" />
              </summary>
              <div class="mt-2 border rounded p-3">
                <mir:textfield xpath="mods:namePart[@type='family']" label="mir.editor.subject.name.editor.namePart.type.family" help-text="{i18n:mir.help.name.family}" />
                <mir:textfield xpath="mods:namePart[@type='given']" label="mir.editor.subject.name.editor.namePart.type.given" help-text="{i18n:mir.help.name.given}" />
                <mir:textfield xpath="mods:nameIdentifier[@type='dante']" label="ditav.mods.agent.nameIdentifier" help-text="{i18n:ditav.mods.agent.nameIdentifier.help}" placeholder="{i18n:ditav.mods.agent.nameIdentifier.uuid}" />
                <xed:bind xpath="mods:nameIdentifier[@type='dante']/@typeURI" initially="https://uri.gbv.de/terminology/lod_persons/">
                  <input type="hidden" />
                </xed:bind>
                <mir:textfield xpath="mods:description" label="ditav.mods.agent.description" help-text="{i18n:ditav.mods.agent.description.help}" placeholder="{i18n:ditav.mods.agent.description.placeholder}" />
              </div>
            </details>
          </div>

        </div>
      </xed:repeat>
    </xed:bind>
  </xed:template>

  <!-- date of reception -->
  <xed:template id="ditav.mods.originInfo.received.displayDate" repeatable="true">
    <mir:textfield xpath="mods:originInfo[@eventType='received']/mods:displayDate" label="ditav.mods.originInfo.received.displayDate" help-text="{i18n:ditav.mods.originInfo.received.displayDate.help}" placeholder="{i18n:ditav.mods.originInfo.received.displayDate.placeholder}" />
  </xed:template>

  <!-- place of reception -->
  <xed:template id="ditav.mods.originInfo.received.placeTerm" repeatable="true">
    <xed:repeat xpath="mods:originInfo[@eventType='received']/mods:place" min="0" max="10">
      <div class="mir-form-group row align-items-center {$xed-validation-marker} mb-3">
        <label class="col-md-3 col-form-label mir-formgroup-label d-flex justify-content-end align-items-center gap-2 text-nowrap pe-3">
          <xed:output i18n="ditav.mods.originInfo.received.placeTerm" />
        </label>
        <div class="col-md-6 d-flex align-items-center">
          <xed:bind xpath="mods:placeTerm">
            <input type="text" class="form-control" placeholder="{i18n:ditav.mods.originInfo.received.placeTerm.placeholder}" />
          </xed:bind>
        </div>
        <div class="col-md-3 text-nowrap">
          <mir:help-pmud help-text="{i18n:ditav.mods.originInfo.received.placeTerm.help}" pmud="true" />
        </div>
        <div class="col-md-3 col-form-label mir-formgroup-label d-flex justify-content-end align-items-center gap-2 text-nowrap pe-3"></div>
        <div class="col-md-6 align-items-center">
          <details>
            <summary class="btn btn-outline-secondary btn-sm">
              <xed:output i18n="ditav.mods.agent.details" />
            </summary>
            <div class="mt-2 border rounded p-3">
              <mir:textfield xpath="mods:placeIdentifier" label="ditav.mods.originInfo.received.placeIdentifier" help-text="{i18n:ditav.mods.originInfo.received.placeIdentifier.help}" placeholder="{i18n:ditav.mods.originInfo.received.placeIdentifier.placeholder}" />
              <mir:textfield xpath="mods:cartographics/coordinates" label="ditav.mods.originInfo.received.coordinates" help-text="{i18n:mir.help.place}" placeholder="{i18n:ditav.mods.originInfo.received.coordinates.placeholder}" />
            </div>
          </details>
        </div>
      </div>
    </xed:repeat>
  </xed:template>

  <!-- subject - topic -->
  <xed:template id="ditav.mods.subject.topic" repeatable="true">
    <xed:repeat xpath="mods:subject[@xlink:type='simple']/mods:topic[not(@type)]" min="0" max="10">
      <mir:textfield xpath="." label="ditav.mods.subject.topic.label" help-text="{i18n:ditav.mods.subject.topic.help}" placeholder="{i18n:ditav.mods.subject.topic.placeholder}" />
    </xed:repeat>
  </xed:template>
  
  <!-- subject - person name -->
  <xed:template id="ditav.mods.subject.personal" repeatable="true">
    <xed:repeat xpath="mods:subject[@xlink:type='simple']/mods:name[@type='personal']" min="0" max="10">
      <div class="mir-form-group row align-items-center {$xed-validation-marker} mb-3">
        <label class="col-md-3 col-form-label mir-formgroup-label d-flex justify-content-end align-items-center gap-2 text-nowrap pe-3">
          <xed:output i18n="ditav.mods.subject.personal.label" />
        </label>
        <div class="col-md-6 d-flex align-items-center">
          <xed:bind xpath="@type" initially="personal">
            <input type="hidden" />
          </xed:bind>
          <xed:bind xpath="@xlink:type" initially="simple">
            <input type="hidden" />
          </xed:bind>
          <xed:bind xpath="mods:displayForm">
            <input type="text" class="form-control" placeholder="{i18n:ditav.mods.subject.personal.placeholder}" />
          </xed:bind>
        </div>
        <div class="col-md-3 text-nowrap">
          <mir:help-pmud help-text="{i18n:ditav.mods.subject.personal.help}" pmud="true" />
        </div>
        <div class="col-md-3 col-form-label mir-formgroup-label d-flex justify-content-end align-items-center gap-2 text-nowrap pe-3"></div>
        <div class="col-md-6 align-items-center">
          <details>
            <summary class="btn btn-outline-secondary btn-sm">
              <xed:output i18n="ditav.mods.agent.details" />
            </summary>
            <div class="mt-2 border rounded p-3">
              <mir:textfield xpath="mods:namePart[@type='family']" label="mir.editor.subject.name.editor.namePart.type.family" help-text="{i18n:mir.help.name.family}" />
              <mir:textfield xpath="mods:namePart[@type='given']" label="mir.editor.subject.name.editor.namePart.type.given" help-text="{i18n:mir.help.name.given}" />
              <xed:bind xpath="mods:role/mods:roleTerm[@authority='marcrelator'][@type='code']" initially="asn">
                <input type="hidden" />
              </xed:bind>
              <mir:textfield xpath="mods:nameIdentifier[@type='dante']" label="ditav.mods.agent.nameIdentifier" help-text="{i18n:ditav.mods.agent.nameIdentifier.help}" placeholder="{i18n:ditav.mods.agent.nameIdentifier.uuid}" />
              <xed:bind xpath="mods:nameIdentifier[@type='dante']/@typeURI" initially="https://uri.gbv.de/terminology/lod_persons/">
                <input type="hidden" />
              </xed:bind>
            </div>
          </details>
        </div>
      </div>
    </xed:repeat>
  </xed:template>

  <!-- subject - corporate name -->
  <xed:template id="ditav.mods.subject.corporate" repeatable="true">
    <xed:repeat xpath="mods:subject[@xlink:type='simple']/mods:name[@type='corporate']" min="0" max="10">
      <div class="mir-form-group row align-items-center {$xed-validation-marker} mb-3">
        <label class="col-md-3 col-form-label mir-formgroup-label d-flex justify-content-end align-items-center gap-2 text-nowrap pe-3">
          <xed:output i18n="ditav.mods.subject.corporate.label" />
        </label>
        <div class="col-md-6 d-flex align-items-center">
          <xed:bind xpath="@type" initially="corporate">
            <input type="hidden" />
          </xed:bind>
          <xed:bind xpath="@xlink:type" initially="simple">
            <input type="hidden" />
          </xed:bind>
          <xed:bind xpath="mods:displayForm">
            <input type="text" class="form-control" placeholder="{i18n:ditav.mods.subject.corporate.placeholder}" />
          </xed:bind>
        </div>
        <div class="col-md-3 text-nowrap">
          <mir:help-pmud help-text="{i18n:ditav.mods.subject.corporate.help}" pmud="true" />
        </div>
        <div class="col-md-3 col-form-label mir-formgroup-label d-flex justify-content-end align-items-center gap-2 text-nowrap pe-3"></div>
        <div class="col-md-6 align-items-center">
          <details>
            <summary class="btn btn-outline-secondary btn-sm">
              <xed:output i18n="ditav.mods.agent.details" />
            </summary>
            <div class="mt-2 border rounded p-3">
              <mir:textfield xpath="mods:namePart[@type='family']" label="mir.editor.subject.name.editor.namePart.type.family" help-text="{i18n:mir.help.name.family}" />
              <mir:textfield xpath="mods:namePart[@type='given']" label="mir.editor.subject.name.editor.namePart.type.given" help-text="{i18n:mir.help.name.given}" />
              <xed:bind xpath="mods:role/mods:roleTerm[@authority='marcrelator'][@type='code']" initially="asn">
                <input type="hidden" />
              </xed:bind>
              <mir:textfield xpath="mods:nameIdentifier[@type='dante']" label="ditav.mods.agent.nameIdentifier" help-text="{i18n:ditav.mods.agent.nameIdentifier.help}" placeholder="{i18n:ditav.mods.agent.nameIdentifier.uuid}" />
              <xed:bind xpath="mods:nameIdentifier[@type='dante']/@typeURI" initially="https://uri.gbv.de/terminology/lod_persons/">
                <input type="hidden" />
              </xed:bind>
            </div>
          </details>
        </div>
      </div>
    </xed:repeat>
  </xed:template>

  <!-- comment on source -->
  <xed:template id="ditav.note.source_note">
    <mir:textfield xpath="mods:note[@type='source_note']" label="ditav.mods.note.comment.label" help-text="{i18n:ditav.mods.note.comment.help}" placeholder="{i18n:ditav.mods.note.comment.placeholder}" />
  </xed:template>

  <!-- comment on language -->
  <xed:template id="ditav.note.language_note">
    <mir:textfield xpath="mods:note[@type='language']" label="ditav.mods.note.language.label" help-text="{i18n:ditav.mods.note.language.help}" placeholder="{i18n:ditav.mods.note.language.placeholder}" />
  </xed:template>

  <!-- original or copy -->
  <xed:template id="ditav.note.original_or_copy">
    <mir:textfield xpath="mods:note[@type='original_or_copy']" label="ditav.mods.note.originalOrCopy.label" help-text="{i18n:ditav.mods.note.originalOrCopy.help}" placeholder="{i18n:ditav.mods.note.originalOrCopy.placeholder}" />
  </xed:template>

  <!-- Number of folios in the record -->
  <xed:template id="ditav.mods.physicalDescription.extent">
    <mir:textfield xpath="mods:physicalDescription/mods:extent" label="ditav.mods.extent.label" help-text="{i18n:ditav.mods.extent.help}" placeholder="{i18n:ditav.mods.extent.placeholder}" />
  </xed:template>

  <!--  archive number (shelfLocator)   -->
  <xed:template id="ditav.mods.location.shelfLocator">
    <mir:textfield xpath="mods:location/mods:shelfLocator" label="ditav.mods.shelfLocator.label" help-text="{i18n:ditav.mods.shelfLocator.help}" placeholder="{i18n:ditav.mods.shelfLocator.placeholder}" />
  </xed:template>

  <!-- transcription -->
  <xed:template id="ditav.mods.classification.transcription">
    <xed:bind xpath="mods:classification[@authorityURI='https://ditav.gbv.de/api/v2/classifications/transcription'][@displayLabel='transcription']/@valueURIxEditor">
      <div class="mir-form-group row {$xed-validation-marker}">
        <label class="col-md-3 col-form-label text-end form-label">
