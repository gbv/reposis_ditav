          </select>
        </div>
        <mir:help-pmud help-text="{i18n:lod_document_classification.help}" pmud="false" />
      </div>
    </xed:bind>
  </xed:template>


  <!-- KOLOE -->

  <!-- koloe document genres -->
  <xed:template id="koloe.genres.document">
      <xed:include ref="title.complex.repeated" />
      <!-- author -->
      <xed:include ref="author.repeated" />
      <!-- date of creation -->
      <xed:include ref="research.data.date.repeated" />
      <!-- place of creation -->
      <xed:include ref="creator.place" />
      <!-- language -->
      <xed:include ref="language" />
      <!-- document classification -->
      <xed:include ref="koloe_document_classification" />
      <!-- topic classification -->
      <xed:include ref="koloe_topic_classification" />
      <!-- continents -->
      <xed:include ref="koloe_continents" />
      <!-- colony -->
      <xed:include ref="koloe_colony" />
      <!-- period -->
      <xed:include ref="koloe_period" />
      <!-- keywords -->
      <xed:include ref="subject.complex.required" />
      <!-- geographic and cartographic metadata -->
      <xed:include ref="geographicAndCartographics" />
      <!-- archives -->
      <xed:include ref="koloe_archives" />
      <!-- shelf mark -->
      <xed:include ref="shelfmark" />
      <!--link to the physical location of the resource -->
      <xed:include ref="link.repeated" />
      <!-- extent -->
      <xed:include ref="extent" />
      <!-- copyrights -->
      <xed:include ref="rights" />
      <!-- abstract -->
      <xed:include ref="abstract.repeated" />
      <!-- add resource class-->
      <xed:bind xpath="mods:typeOfResource/@mcr:categId" initially="typeOfResource:text" />
  </xed:template>

  <xed:template id="koloe.genres.contextual_information">
    <!-- text classification (A, B, or C text) -->
    <xed:include ref="koloe_text_classification" />
    <!-- related to source -->
    <xed:include ref="ditav.related.item.other.search.of.all.items" />
    <!-- title -->
    <xed:include ref="title.complex.repeated" />
    <!-- authors -->
    <xed:include ref="author.repeated" />
    <!-- copyrights -->
    <xed:include ref="rights" />
    <!-- abstract -->
    <xed:include ref="abstract.repeated" />
    <!-- add resource class-->
    <xed:bind xpath="mods:typeOfResource/@mcr:categId" initially="typeOfResource:text" />
  </xed:template>

  <!-- koloe source genres -->
  <xed:template id="koloe.genres.source">
      <xed:include ref="title.complex.repeated" />
      <!-- author -->
      <xed:include ref="author.repeated" />
      <!-- date of creation -->
      <xed:include ref="research.data.date.repeated" />
      <!-- place of creation -->
      <xed:include ref="creator.place" />
      <!-- language -->
      <xed:include ref="language" />
      <!-- document classification -->
      <xed:include ref="koloe_document_classification" />
      <!-- topic classification -->
      <xed:include ref="koloe_topic_classification" />
      <!-- trigger warning -->
      <xed:include ref="koloe_trigger_warning" />
      <!-- continents -->
      <xed:include ref="koloe_continents" />
      <!-- colony -->
      <xed:include ref="koloe_colony" />
      <!-- period -->
      <xed:include ref="koloe_period" />
      <!-- keywords -->
      <xed:include ref="subject.complex.required" />
      <!-- geographic and cartographic metadata -->
      <xed:include ref="geographicAndCartographics" />
      <!-- archives -->
      <xed:include ref="koloe_archives" />
      <!-- shelf mark -->
      <xed:include ref="shelfmark" />
      <!--link to the physical location of the resource -->
      <xed:include ref="link.repeated" />
      <!-- extent -->
      <xed:include ref="extent" />
      <!-- copyrights -->
      <xed:include ref="rights" />
      <!-- abstract -->
      <xed:include ref="abstract.repeated" />
      <!-- add resource class-->
      <xed:bind xpath="mods:typeOfResource/@mcr:categId" initially="typeOfResource:text" />
  </xed:template>

  <!-- koloe supplement genres -->
  <xed:template id="koloe.genres.supplement">
      <!-- title -->
      <xed:include ref="title.complex.repeated" />
      <!-- author -->
      <xed:include ref="author.repeated" />
      <!-- date of creation -->
      <xed:include ref="research.data.date.repeated" />
      <!-- place of creation -->
